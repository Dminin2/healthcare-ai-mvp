# -------------------------------------------------------
# Healthcare AI API – 環境変数設定サンプル
# このファイルを .env にコピーして値を設定してください。
# .env は .gitignore に含まれているため、リポジトリには含まれません。
# -------------------------------------------------------

# ---------- データベース ----------
# 用途に応じて以下のいずれか1行を有効にしてください。

# [1] SQLite（ローカル開発・Docker不使用の場合）
# DATABASE_URL=sqlite:///./healthcare_ai.db

# [2] PostgreSQL（ローカル Docker Compose — api コンテナから db コンテナへ接続）
#     ホスト名は Docker 内部サービス名 "db"（localhost ではない）
DATABASE_URL=postgresql://postgres:postgres@db:5432/healthcare_ai

# [3] PostgreSQL（ローカル Docker Compose — ホストマシンから直接接続する場合）
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_ai

# [4] Supabase — Transaction mode（Render 本番環境で推奨）
#     PgBouncer 経由でコネクションプーリングを行うため、接続数が少なく済む。
#     ポート 6543 を使用。?sslmode=require は必須。
#     Supabase ダッシュボード → Project Settings → Database → Connection string → URI
#     (Transaction mode を選択してコピー)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# [5] Supabase — Direct connection（ローカルからの動作確認用）
#     プーラーを経由しない直接接続。同時接続数の上限が低いため本番には向かない。
#     ポート 5432 を使用。?sslmode=require は必須。
#     Supabase ダッシュボード → Project Settings → Database → Connection string → URI
#     (Session mode / Direct を選択してコピー)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# ---------- 認証 ----------
# 以下のコマンドで生成したランダム文字列を設定してください:
#   openssl rand -hex 32
# 本番環境では必ず変更すること。
SECRET_KEY=dev-secret-key-CHANGE-THIS-IN-PRODUCTION

# JWT アクセストークンの有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- LLM ----------
# "gemini" に設定すると Gemini API を使用します。それ以外はルールベースのフォールバック。
LLM_PROVIDER=none

# Google Gemini API キー（LLM_PROVIDER=gemini の場合のみ必要）
GEMINI_API_KEY=

# 使用するモデル（デフォルト: gemini-1.5-flash）
GEMINI_MODEL=gemini-1.5-flash
