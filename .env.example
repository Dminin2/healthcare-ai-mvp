# -------------------------------------------------------
# Healthcare AI API – 環境変数設定サンプル
# このファイルを .env にコピーして値を設定してください。
# .env は .gitignore に含まれているため、リポジトリには含まれません。
# -------------------------------------------------------

# ---------- データベース ----------
# SQLite（ローカル開発）
# DATABASE_URL=sqlite:///./healthcare_ai.db

# PostgreSQL（ローカル Docker Compose）※ Docker外から直接接続する場合は @localhost
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_ai

# PostgreSQL（Docker Compose 内部 — api コンテナから db コンテナへ接続）
DATABASE_URL=postgresql://postgres:postgres@db:5432/healthcare_ai

# PostgreSQL（本番 / Render + Supabase）
# DATABASE_URL=postgresql://user:password@host:5432/healthcare_ai?sslmode=require

# ---------- 認証 ----------
# 以下のコマンドで生成したランダム文字列を設定してください:
#   openssl rand -hex 32
# 本番環境では必ず変更すること。
SECRET_KEY=dev-secret-key-CHANGE-THIS-IN-PRODUCTION

# JWT アクセストークンの有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- LLM ----------
# "gemini" に設定すると Gemini API を使用します。それ以外はテンプレートフォールバック。
LLM_PROVIDER=none

# Google Gemini API キー（LLM_PROVIDER=gemini の場合に必要）
GEMINI_API_KEY=

# 使用するモデル（デフォルト: gemini-1.5-flash）
GEMINI_MODEL=gemini-1.5-flash
